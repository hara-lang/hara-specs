{:document/id :hal/native-metaspec
 :document/type :hara/metaspec
 :document/version "0.1.0"
 :document/status :draft
 :document/title "HAL native boundary specification meta-spec"
 :document/summary
 "Defines the machine-readable contract for std.native and std.native.* runtime adapters."

 :spec/conforms-to
 {:spec/id :hara/metaspec-metaspec
  :spec/version "0.1.0"}
 :spec/artifact-kind :hal/native-spec

 :meta/document-schema
 {:schema/id :hal.native.metaspec/document
  :schema/type :map
  :schema/closed false
  :schema/required
  [:document/id :document/type :document/version :document/status
   :document/title :document/summary :spec/conforms-to
   :native/scope :native/invariants :native/naming :native/types
   :native/capabilities :native/profiles :native/errors
   :native/references :native/conformance]
  :schema/properties
  {:document/id {:schema/ref :hal.native.metaspec/qualified-keyword}
   :document/type {:schema/value :native-spec}
   :document/version {:schema/ref :hal.native.metaspec/version-string}
   :document/status {:schema/ref :hal.native.metaspec/status}
   :document/title {:schema/ref :hal.native.metaspec/non-empty-string}
   :document/summary {:schema/ref :hal.native.metaspec/non-empty-string}
   :spec/conforms-to {:schema/ref :hal.native.metaspec/spec-reference}
   :native/scope {:schema/type :map}
   :native/invariants {:schema/type :vector
                       :schema/items :hal.native.metaspec/requirement}
   :native/naming {:schema/type :map}
   :native/types {:schema/type :vector
                  :schema/items :hal.native.metaspec/native-type}
   :native/capabilities {:schema/type :map}
   :native/profiles {:schema/type :map}
   :native/errors {:schema/type :vector}
   :native/references {:schema/type :vector
                       :schema/items :hal.native.metaspec/reference}
   :native/conformance {:schema/type :vector
                        :schema/items :hal.native.metaspec/conformance}}}

 :meta/schemas
 [{:schema/id :hal.native.metaspec/qualified-keyword
   :schema/type :keyword
   :schema/constraint :qualified}
  {:schema/id :hal.native.metaspec/non-empty-string
   :schema/type :string
   :schema/min-length 1}
  {:schema/id :hal.native.metaspec/version-string
   :schema/type :string
   :schema/pattern "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}
  {:schema/id :hal.native.metaspec/status
   :schema/type :enum
   :schema/values [:draft :candidate :stable :deprecated :retired]}
  {:schema/id :hal.native.metaspec/spec-reference
   :schema/type :map
   :schema/required [:spec/id :spec/version]}
  {:schema/id :hal.native.metaspec/requirement
   :schema/type :map
   :schema/required
   [:requirement/id :requirement/level :requirement/text]}
  {:schema/id :hal.native.metaspec/native-type
   :schema/type :map
   :schema/required
   [:native/id :native/symbol :native/namespace :native/availability
    :native/methods]}
  {:schema/id :hal.native.metaspec/reference
   :schema/type :map
   :schema/required
   [:reference/id :reference/path :reference/authority]}
  {:schema/id :hal.native.metaspec/conformance
   :schema/type :map
   :schema/required
   [:conformance/id :conformance/path :conformance/authority]}]

 :meta/cross-references
 [{:reference/id :hal.native.metaspec/capability-reference
   :reference/from :native/capability
   :reference/to :capability/id}
  {:reference/id :hal.native.metaspec/conformance-path
   :reference/from :conformance/path
   :reference/to :document-relative-path}]

 :meta/requirements
 [{:requirement/id :hal.native.metaspec/complete-catalog
   :requirement/level :must
   :requirement/text
   "Every native type declares its namespace, methods, availability, and capability requirements."}
  {:requirement/id :hal.native.metaspec/no-ambient-authority
   :requirement/level :must
   :requirement/text
   "Loading a native namespace grants no filesystem, network, process, reflection, or compilation authority."}
  {:requirement/id :hal.native.metaspec/profile-parity
   :requirement/level :must
   :requirement/text
   "JVM, Rust, and Wasm differences are explicit profile declarations."}
  {:requirement/id :hal.native.metaspec/qualified-keys
   :requirement/level :must
   :requirement/text "Unknown extension keys are qualified keywords."}]

 :meta/checkers
 [{:checker/id :hal.native.metaspec.rule/qualified-key
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-map-keys
   :checker/requirement :hal.native.metaspec/qualified-keys}
  {:checker/id :hal.native.metaspec.rule/duplicate-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/unique-field-values
   :checker/requirement :hal.native.metaspec/complete-catalog
   :checker/fields
   [:document/id :native/id :requirement/id :reference/id :conformance/id]}]

 :metaspec/generation
 {:generation/input
  {:input/type :hal.native.metaspec/request
   :input/required
   [:request/title :request/types :request/capabilities :request/profiles]}
  :generation/output
  {:output/type :hal/native-spec
   :output/format :edn
   :output/required
   [:document/id :document/type :document/version :document/status
    :document/title :document/summary :spec/conforms-to
    :native/scope :native/invariants :native/naming :native/types
    :native/capabilities :native/profiles :native/errors
    :native/references :native/conformance]}
  :generation/process
  [:inventory-jvm :inventory-rust :reconcile-catalog :generate-draft
   :lint :repair-findings :emit-canonical-edn]
  :generation/acceptance
  {:acceptance/status :pass
   :acceptance/required-summary
   {:summary/fail 0 :summary/unknown 0 :summary/blocked 0}}}}
