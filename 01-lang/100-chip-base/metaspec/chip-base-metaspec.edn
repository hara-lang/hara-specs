{:document/id :hal/chip-base-metaspec
 :document/type :hara/metaspec
 :document/version "0.1.0"
 :document/status :draft
 :document/title "HAL chip-base specification meta-spec"
 :document/summary
 "Defines the machine-readable shape of the portable HAL AST matching coprocessor contract."

 :spec/conforms-to
 {:spec/id :hara/metaspec-metaspec
  :spec/version "0.1.0"}
 :spec/artifact-kind :hal/chip-base-spec

 :meta/document-schema
 {:schema/id :hal.chip-base.metaspec/document
  :schema/type :map
  :schema/closed false
  :schema/required
  [:document/id :document/type :document/version :document/status
   :document/title :document/summary :spec/conforms-to
   :chip/scope :chip/invariants :chip/parameters :chip/node-format
   :chip/program-format :chip/commands :chip/results :chip/errors
   :chip/references :chip/conformance]
  :schema/properties
  {:document/id {:schema/ref :hal.chip-base.metaspec/qualified-keyword}
   :document/type {:schema/value :chip-base-spec}
   :document/version {:schema/ref :hal.chip-base.metaspec/version-string}
   :document/status {:schema/ref :hal.chip-base.metaspec/status}
   :document/title {:schema/ref :hal.chip-base.metaspec/non-empty-string}
   :document/summary {:schema/ref :hal.chip-base.metaspec/non-empty-string}
   :spec/conforms-to {:schema/ref :hal.chip-base.metaspec/spec-reference}
   :chip/scope {:schema/type :map}
   :chip/invariants {:schema/type :vector
                     :schema/items :hal.chip-base.metaspec/requirement}
   :chip/parameters {:schema/type :map}
   :chip/node-format {:schema/type :map}
   :chip/program-format {:schema/type :map}
   :chip/commands {:schema/type :vector}
   :chip/results {:schema/type :map}
   :chip/errors {:schema/type :vector}
   :chip/references {:schema/type :vector}
   :chip/conformance {:schema/type :vector}}}

 :meta/schemas
 [{:schema/id :hal.chip-base.metaspec/qualified-keyword
   :schema/type :keyword
   :schema/constraint :qualified}
  {:schema/id :hal.chip-base.metaspec/non-empty-string
   :schema/type :string
   :schema/min-length 1}
  {:schema/id :hal.chip-base.metaspec/version-string
   :schema/type :string
   :schema/pattern "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}
  {:schema/id :hal.chip-base.metaspec/status
   :schema/type :enum
   :schema/values [:draft :candidate :stable :deprecated :retired]}
  {:schema/id :hal.chip-base.metaspec/spec-reference
   :schema/type :map
   :schema/required [:spec/id :spec/version]}
  {:schema/id :hal.chip-base.metaspec/requirement
   :schema/type :map
   :schema/closed false
   :schema/required
   [:requirement/id :requirement/level :requirement/text]}
  {:schema/id :hal.chip-base.metaspec/conformance-reference
   :schema/type :map
   :schema/required
   [:conformance/id :conformance/path :conformance/authority]}]

 :meta/cross-references
 [{:reference/id :hal.chip-base.metaspec/opcode-reference
   :reference/from :instruction/opcode
   :reference/to :opcode/name}
  {:reference/id :hal.chip-base.metaspec/error-reference
   :reference/from :result/error
   :reference/to :error/name}
  {:reference/id :hal.chip-base.metaspec/conformance-path-reference
   :reference/from :conformance/path
   :reference/to :document-relative-path}]

 :meta/requirements
 [{:requirement/id :hal.chip-base.metaspec/portable-semantics
   :requirement/level :must
   :requirement/text
   "The document separates portable matching semantics from transport-specific integration."}
  {:requirement/id :hal.chip-base.metaspec/bounded-state
   :requirement/level :must
   :requirement/text
   "The document defines finite node-register, binding-register, program, and arena bounds."}
  {:requirement/id :hal.chip-base.metaspec/deterministic-failure
   :requirement/level :must
   :requirement/text
   "Malformed jobs terminate with a specified fault rather than reading outside declared arenas."}
  {:requirement/id :hal.chip-base.metaspec/qualified-keys
   :requirement/level :must
   :requirement/text "Unknown extension keys are qualified keywords."}]

 :meta/checkers
 [{:checker/id :hal.chip-base.metaspec.rule/qualified-key
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-map-keys
   :checker/requirement :hal.chip-base.metaspec/qualified-keys}
  {:checker/id :hal.chip-base.metaspec.rule/stable-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-field-values
   :checker/requirement :hal.chip-base.metaspec/portable-semantics
   :checker/fields
   [:document/id :requirement/id :reference/id :conformance/id]}
  {:checker/id :hal.chip-base.metaspec.rule/duplicate-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/unique-field-values
   :checker/requirement :hal.chip-base.metaspec/portable-semantics
   :checker/fields
   [:document/id :requirement/id :reference/id :conformance/id]}]

 :metaspec/generation
 {:generation/input
  {:input/type :hal.chip-base.metaspec/request
   :input/required
   [:request/title :request/scope :request/node-format
    :request/program-format :request/commands :request/results]}
  :generation/output
  {:output/type :hal/chip-base-spec
   :output/format :edn
   :output/required
   [:document/id :document/type :document/version :document/status
    :document/title :document/summary :spec/conforms-to
    :chip/scope :chip/invariants :chip/parameters :chip/node-format
    :chip/program-format :chip/commands :chip/results :chip/errors
    :chip/references :chip/conformance]}
  :generation/process
  [:generate-draft :lint :repair-findings :emit-canonical-edn]
  :generation/acceptance
  {:acceptance/status :pass
   :acceptance/required-summary
   {:summary/fail 0 :summary/unknown 0 :summary/blocked 0}}}}
