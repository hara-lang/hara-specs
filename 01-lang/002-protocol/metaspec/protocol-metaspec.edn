{:document/id :hal/protocol-metaspec
 :document/type :hara/metaspec
 :document/version "0.1.0"
 :document/status :draft
 :document/title "HAL protocol specification meta-spec"
 :document/summary
 "Defines the machine-readable contract for the built-in std.protocol.* namespace family."

 :spec/conforms-to
 {:spec/id :hara/metaspec-metaspec
  :spec/version "0.1.0"}
 :spec/artifact-kind :hal/protocol-spec

 :meta/document-schema
 {:schema/id :hal.protocol.metaspec/document
  :schema/type :map
  :schema/closed false
  :schema/required
  [:document/id :document/type :document/version :document/status
   :document/title :document/summary :spec/conforms-to
   :protocol/scope :protocol/invariants :protocol/naming :protocol/catalog
   :protocol/dispatch :protocol/extension :protocol/errors
   :protocol/references :protocol/conformance]
  :schema/properties
  {:document/id {:schema/ref :hal.protocol.metaspec/qualified-keyword}
   :document/type {:schema/value :protocol-spec}
   :document/version {:schema/ref :hal.protocol.metaspec/version-string}
   :document/status {:schema/ref :hal.protocol.metaspec/status}
   :document/title {:schema/ref :hal.protocol.metaspec/non-empty-string}
   :document/summary {:schema/ref :hal.protocol.metaspec/non-empty-string}
   :spec/conforms-to {:schema/ref :hal.protocol.metaspec/spec-reference}
   :protocol/scope {:schema/type :map}
   :protocol/invariants {:schema/type :vector
                         :schema/items :hal.protocol.metaspec/requirement}
   :protocol/naming {:schema/type :map}
   :protocol/catalog {:schema/type :vector
                      :schema/items :hal.protocol.metaspec/protocol}
   :protocol/dispatch {:schema/type :map}
   :protocol/extension {:schema/type :map}
   :protocol/errors {:schema/type :vector}
   :protocol/references {:schema/type :vector
                         :schema/items :hal.protocol.metaspec/reference}
   :protocol/conformance {:schema/type :vector
                          :schema/items :hal.protocol.metaspec/conformance}}}

 :meta/schemas
 [{:schema/id :hal.protocol.metaspec/qualified-keyword
   :schema/type :keyword
   :schema/constraint :qualified}
  {:schema/id :hal.protocol.metaspec/non-empty-string
   :schema/type :string
   :schema/min-length 1}
  {:schema/id :hal.protocol.metaspec/version-string
   :schema/type :string
   :schema/pattern "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}
  {:schema/id :hal.protocol.metaspec/status
   :schema/type :enum
   :schema/values [:draft :candidate :stable :deprecated :retired]}
  {:schema/id :hal.protocol.metaspec/spec-reference
   :schema/type :map
   :schema/required [:spec/id :spec/version]}
  {:schema/id :hal.protocol.metaspec/requirement
   :schema/type :map
   :schema/required
   [:requirement/id :requirement/level :requirement/text]}
  {:schema/id :hal.protocol.metaspec/protocol
   :schema/type :map
   :schema/required
   [:protocol/id :protocol/symbol :protocol/namespace :protocol/methods]}
  {:schema/id :hal.protocol.metaspec/reference
   :schema/type :map
   :schema/required
   [:reference/id :reference/path :reference/authority]}
  {:schema/id :hal.protocol.metaspec/conformance
   :schema/type :map
   :schema/required
   [:conformance/id :conformance/path :conformance/authority]}]

 :meta/cross-references
 [{:reference/id :hal.protocol.metaspec/extends-reference
   :reference/from :protocol/extends
   :reference/to :protocol/id}
  {:reference/id :hal.protocol.metaspec/conformance-path
   :reference/from :conformance/path
   :reference/to :document-relative-path}]

 :meta/requirements
 [{:requirement/id :hal.protocol.metaspec/complete-catalog
   :requirement/level :must
   :requirement/text
   "Every built-in protocol declares its canonical namespace, methods, arities, and inheritance."}
  {:requirement/id :hal.protocol.metaspec/portable-dispatch
   :requirement/level :must
   :requirement/text
   "Dispatch and extension semantics are independent of the implementation host."}
  {:requirement/id :hal.protocol.metaspec/case-coverage
   :requirement/level :must
   :requirement/text
   "Every public method has executable evidence or an explicit evidence waiver."}
  {:requirement/id :hal.protocol.metaspec/qualified-keys
   :requirement/level :must
   :requirement/text "Unknown extension keys are qualified keywords."}]

 :meta/checkers
 [{:checker/id :hal.protocol.metaspec.rule/qualified-key
   :checker/type :builtin
   :checker/op :hara.metaspec.check/qualified-map-keys
   :checker/requirement :hal.protocol.metaspec/qualified-keys}
  {:checker/id :hal.protocol.metaspec.rule/duplicate-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/unique-field-values
   :checker/requirement :hal.protocol.metaspec/complete-catalog
   :checker/fields
   [:document/id :protocol/id :requirement/id :reference/id :conformance/id]}]

 :metaspec/generation
 {:generation/input
  {:input/type :hal.protocol.metaspec/request
   :input/required
   [:request/title :request/catalog :request/dispatch :request/extension]}
  :generation/output
  {:output/type :hal/protocol-spec
   :output/format :edn
   :output/required
   [:document/id :document/type :document/version :document/status
    :document/title :document/summary :spec/conforms-to
    :protocol/scope :protocol/invariants :protocol/naming :protocol/catalog
    :protocol/dispatch :protocol/extension :protocol/errors
    :protocol/references :protocol/conformance]}
  :generation/process
  [:inventory-runtime :reconcile-catalog :generate-draft :lint
   :repair-findings :emit-canonical-edn]
  :generation/acceptance
  {:acceptance/status :pass
   :acceptance/required-summary
   {:summary/fail 0 :summary/unknown 0 :summary/blocked 0}}}}
