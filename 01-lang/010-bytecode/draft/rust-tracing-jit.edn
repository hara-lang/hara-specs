{:document/id :hal/rust-tracing-jit
 :document/type :runtime-implementation-spec
 :document/version "0.1.0-draft"
 :document/status :draft
 :runtime :rust
 :feature "tracing-jit"
 :ownership
 {:owner :rust-runtime
  :shared-hal-contract false
  :must-not-appear-in #{:halc :evaluation-journal :java-runtime-requirements}
  :semantic-authority :rust-bytecode-interpreter
  :java-path [:truffle-ast :truffle-specialization :graal]}
 :pipeline
 [:rust-forms :rust-vm-compiler :rust-bytecode :rust-vm-interpreter
  :rust-execution-trace :rust-trace-ir :native-code]
 :features
 {:tracing-jit {:requires #{:bytecode-vm} :default false}
  :native-jit {:requires #{:tracing-jit} :target :non-wasm :default false}
  :browser "The browser uses the bytecode interpreter unless a future wasm-specific backend is explicitly selected."}
 :hotness
 {:key [:program-identity :function-index :backedge-target]
  :counter :saturating-u32
  :default-threshold 64
  :rule "Only backward Jump and taken backward JumpIfFalse edges increment counters."
  :cache "One compiled trace per loop key and program generation."
  :invalidation "Dropping or replacing the Program drops its trace cache; no trace survives semantic-version or registry-generation changes."}
 :recording
 {:start "The interpreter crosses a hot backedge."
  :end "Control returns to the loop header, exits the loop, calls unsupported code, throws, or reaches the recorder limit."
  :default-max-operations 4096
  :inputs "VM instructions, compact slots, local indices, primitive identities, and observed scalar tags."
  :forbidden-inputs #{:evaluation-journal-events :halc-bytes}
  :nested-loops "A trace may contain an inner-loop backedge only after the inner loop has its own compiled trace; otherwise recording side-exits."
  :unsupported "Calls, allocation-heavy values, globals, handlers, and host boundaries end recording with an interpreter side exit."}
 :trace-ir
 {:types #{:i64 :bool :nil :boxed}
  :operations #{:constant-i64 :load-local-i64 :store-local-i64 :add-i64 :sub-i64
                :mul-i64 :rem-i64 :compare-i64 :guard-tag :guard-nonzero
                :guard-overflow :loop-backedge :exit}
  :ssa true
  :rule "IR is internal and reconstructs interpreter-visible state at every guard and exit."}
 :guards
 {:tag "Every unboxed input is guarded by its observed VmSlot tag."
  :arithmetic "Checked integer operations side-exit on overflow; remainder guards divisor nonzero."
  :control "Observed branch direction is guarded."
  :failure "A failed guard never changes HAL behavior; it restores a snapshot and resumes the interpreter."}
 :side-exits
 {:snapshot [:function :instruction-pointer :locals :operand-stack :call-depth]
  :resume "Resume at the first bytecode instruction whose effects were not committed."
  :errors "Language errors are produced by the interpreter after exit, preserving exact diagnostics."
  :journal "When Evaluation Journal collection is enabled, compiled traces are bypassed unless a future implementation proves identical semantic events."}
 :backend
 {:interface [:compile :enter :invalidate]
  :portable-tier "A checked Trace IR executor is the reference backend and differential oracle."
  :native-tier "Optional non-wasm backend lowers the same guarded IR to host machine code."
  :abi {:inputs [:locals-pointer :exit-snapshot-pointer] :result [:completed-iterations-or-side-exit]}
  :w-x "Native memory is writable during emission and executable during entry, never both."
  :size "Native backend dependencies and symbols are absent unless native-jit is enabled."}
 :verification
 {:differential "For every traceable corpus workload compare interpreter, checked Trace IR, and native backend values/errors."
  :forced-exits #{:wrong-tag :branch-change :overflow :division-by-zero :global-change}
  :benchmarks #{:arithmetic-loop :closure-loop :nested-loop :branchy-loop :map-reduce :text-processing}
  :acceptance
  [:interpreter-remains-semantic-authority
   :no-journal-input
   :no-halc-change
   :feature-gated-size-zero-in-default-build
   :all-guard-exits-differentially-tested
   :native-backend-beats-interpreter-on-supported-hot-loops]}}
