---
import { githubBlobUrl, materializationLabel, sourceLocation } from "../lib/registry-links.mjs";
const { spec, registrySource } = Astro.props;
const statusLabel = spec.status === "ready" ? "Ready" : spec.status === "draft" ? "Draft" : "Unclassified";
const location = sourceLocation(spec, registrySource);
const sourceUrl = githubBlobUrl(location);
const sourceState = materializationLabel(spec);
const aliases = (spec.aliases || []).join(" ");
---
<article class="spec-card" data-status={spec.status} data-layer={spec.layer} data-search={`${spec.id} ${aliases} ${spec.coordinate} ${spec.title} ${spec.summary} ${sourceState}`.toLowerCase()}>
  <div class="spec-card-topline"><span class:list={["status-pill", `status-${spec.status}`]}>{statusLabel}</span><span class="version">{spec.version}</span></div>
  <div><p class="package-name">{spec.coordinate}</p><h3><a href={`/specs/${spec.slug}`}>{spec.title}</a></h3><p>{spec.summary}</p></div>
  <dl class="spec-meta"><div><dt>Layer</dt><dd>{spec.layer}</dd></div><div><dt>Rules</dt><dd>{spec.requirements}</dd></div><div><dt>Source</dt><dd>{sourceState}</dd></div></dl>
  <div class="spec-card-actions"><a href={`/specs/${spec.slug}`}>Inspect</a>{sourceUrl && <a href={sourceUrl}>Source</a>}</div>
</article>
