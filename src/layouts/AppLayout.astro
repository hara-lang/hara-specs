---
import HaraMark from "@hara-lang/visual-language/astro/HaraMark.astro";
import ThemeToggle from "@hara-lang/visual-language/astro/ThemeToggle.astro";
import "@hara-lang/visual-language/theme.css";
import "@hara-lang/visual-language/motifs.css";
import "../styles/app.css";
import "../styles/shell.css";

const {
  title = "Hara Specs",
  description = "Publish, inspect, and verify executable Hara specifications.",
  canonicalPath = Astro.url.pathname
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL("/og-hara-specs.jpg", Astro.site);
const activePath = Astro.url.pathname;
const returnTo = `${Astro.url.pathname}${Astro.url.search}`;
const signInHref = `/auth/github?return_to=${encodeURIComponent(returnTo)}`;
const localNav = [
  ["/", "Overview"],
  ["/registry", "Registry"],
  ["/check", "Check"],
  ["/publish", "Publish"],
  ["/developers", "API"]
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080a0d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Specifications" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="3840" />
    <meta property="og:image:height" content="2016" />
    <meta property="og:image:alt" content="Hara Specifications — executable standards" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Hara Specifications — executable standards" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="app-header">
      <a class="brand" href="https://www.hara-lang.org/" aria-label="Hara home">
        <HaraMark size={30} title="Hara" />
        <span><strong>Hara</strong></span>
      </a>
      <nav class="ecosystem-nav" aria-label="Hara ecosystem navigation">
        <a href="https://www.hara-lang.org/benchmarks/">Benchmarks</a>
        <a href="https://www.hara-lang.org/docs/start/orientation/">Docs</a>
        <span aria-current="page" aria-disabled="true">Specs</span>
      </nav>
      <div class="header-actions">
        <a class="sign-in" href={signInHref} data-auth-link aria-label="Sign in with GitHub">
          <svg class="github-mark" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.7 10.7 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.64 5.27-5.15 5.55.4.35.76 1.04.76 2.1v3.11c0 .3.21.65.78.54A11.25 11.25 0 0 0 12 .75Z" />
          </svg>
          <span data-auth-label>Sign in</span>
        </a>
        <form class="sign-out" action="/auth/logout" method="post" data-auth-logout hidden>
          <input type="hidden" name="return_to" value={returnTo} />
          <button type="submit" aria-label="Sign out" title="Sign out">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M10 5H6.5A2.5 2.5 0 0 0 4 7.5v9A2.5 2.5 0 0 0 6.5 19H10M14 8l4 4-4 4M18 12H9" />
            </svg>
          </button>
        </form>
        <ThemeToggle label="Change colour theme" />
      </div>
    </header>
    <nav class="context-nav" aria-label="Specifications navigation">
      <div>
        {localNav.map(([href, label]) => (
          <a href={href} aria-current={activePath === href || (href !== "/" && activePath.startsWith(href)) ? "page" : undefined}>{label}</a>
        ))}
      </div>
    </nav>
    <main id="content">
      <slot />
    </main>
    <footer class="app-footer">
      <div>
        <HaraMark size={26} title="Hara" />
        <span>Executable standards for the Hara ecosystem.</span>
      </div>
      <div class="footer-links">
        <a href="https://opensource.greenways.ai/open-source/">A Greenways Open Source Project</a>
        <a href="https://github.com/hara-lang/hara-specs/blob/main/LICENSE">Apache-2.0</a>
        <a href="https://github.com/hara-lang/hara-specs">Service source</a>
        <a href="https://github.com/hara-lang/hara-specs-registry">Registry source</a>
        <a href="/developers">API</a>
        <a href="/registry/index.json">Registry JSON</a>
        <a href="/check">Checker</a>
      </div>
    </footer>
    <script>
      import { getThemePreference } from "@hara-lang/visual-language/theme.js";

      const themeIcons = {
        system: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>',
        light: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>',
        dark: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z"></path></svg>'
      };
      const themeOrder = ["system", "light", "dark"];

      const syncThemeIcon = () => {
        const preference = getThemePreference();
        const next = themeOrder[(themeOrder.indexOf(preference) + 1) % themeOrder.length];
        document.querySelectorAll("[data-hara-theme-toggle]").forEach((button) => {
          const icon = button.querySelector("[data-hara-theme-icon]");
          if (icon) icon.innerHTML = themeIcons[preference] || themeIcons.system;
          const currentLabel = preference.replace(/^./, (value) => value.toUpperCase());
          const nextLabel = next.replace(/^./, (value) => value.toUpperCase());
          button.setAttribute("aria-label", `${currentLabel} theme. Switch to ${nextLabel}.`);
          button.setAttribute("title", `${currentLabel} theme`);
        });
      };

      const syncSession = async () => {
        const authLink = document.querySelector("[data-auth-link]");
        const authLabel = authLink?.querySelector("[data-auth-label]");
        const logout = document.querySelector("[data-auth-logout]");
        if (!(authLink instanceof HTMLAnchorElement) || !authLabel) return;

        try {
          const response = await fetch("/api/auth/session", {
            credentials: "same-origin",
            cache: "no-store",
            headers: { Accept: "application/json" }
          });
          if (!response.ok) return;
          const session = await response.json();
          if (!session?.authenticated || !session?.user?.login) return;

          authLabel.textContent = `@${session.user.login}`;
          authLink.href = session.user.profileUrl || `https://github.com/${encodeURIComponent(session.user.login)}`;
          authLink.classList.add("is-authenticated");
          authLink.setAttribute("aria-label", `Signed in as ${session.user.login} on GitHub`);
          if (logout instanceof HTMLFormElement) logout.hidden = false;
        } catch {}
      };

      const initialiseShell = () => {
        syncThemeIcon();
        syncSession();
      };

      document.addEventListener("astro:page-load", initialiseShell);
      addEventListener("hara:theme-change", syncThemeIcon);
      initialiseShell();
    </script>
  </body>
</html>
