---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Not found — Hara Specs">
  <section class="not-found section-shell">
    <p class="hara-kicker">404</p>
    <h1>This specification path does not exist.</h1>
    <p>The package may have moved, been yanked from default resolution, or not yet been published.</p>
    <a class="button button-primary" href="/registry">Return to the registry</a>
  </section>
</AppLayout>
