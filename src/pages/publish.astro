---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Publish a specification — Hara Specs" description="Prepare and validate a versioned Hara specification package for publication.">
  <section class="page-heading section-shell">
    <p class="hara-kicker">Package publishing</p>
    <h1>Prepare a specification release.</h1>
    <p>Specification packages use the same namespace, version, dependency, fixture, and signature model as Hara packages. This first surface validates the release manifest and produces a portable submission bundle.</p>
  </section>

  <section class="publish-grid section-shell">
    <form class="publisher-form hara-surface" data-publish-form>
      <div class="form-row two-column">
        <label><span>Package name</span><input name="name" value="@greenways/invoice-au" required /></label>
        <label><span>Version</span><input name="version" value="1.0.0" required /></label>
      </div>
      <div class="form-row two-column">
        <label>
          <span>Package kind</span>
          <select name="kind">
            <option value="hara/spec">hara/spec</option>
            <option value="hara/profile">hara/profile</option>
            <option value="hara/rules">hara/rules</option>
            <option value="hara/adapter">hara/adapter</option>
            <option value="hara/dataset">hara/dataset</option>
          </select>
        </label>
        <label><span>Entry point</span><input name="entry" value="spec/main.hal" required /></label>
      </div>
      <label><span>Accepted media types</span><input name="accepts" value="application/json, application/pdf" /></label>
      <label><span>Description</span><textarea name="description" rows="3">Australian invoice conformance profile.</textarea></label>
      <div class="form-row two-column">
        <label><span>Licence</span><input name="license" value="Apache-2.0" /></label>
        <label><span>Capabilities</span><input name="capabilities" placeholder="document/read" /></label>
      </div>
      <label class="file-drop compact">
        <input type="file" multiple data-package-files />
        <span><strong>Add source, fixtures, and normative documents</strong><small>Files are inventoried locally; they are not uploaded by this prototype.</small></span>
      </label>
      <div class="file-inventory" data-file-inventory>No package files selected.</div>
      <div class="form-actions">
        <button class="button button-primary" type="submit">Validate release</button>
        <button class="button" type="button" data-download-manifest>Download manifest</button>
      </div>
    </form>

    <aside class="publisher-preview hara-surface">
      <div class="preview-heading"><div><p class="hara-kicker">Release preview</p><h2>hara.package.json</h2></div><span data-package-state>Not validated</span></div>
      <pre><code data-manifest-preview></code></pre>
      <div class="validation-results" data-validation-results>
        Complete the manifest and validate it against the registry package contract.
      </div>
      <div class="publishing-gate">
        <strong>Registry submission transport</strong>
        <p>The UI and validation API are active. Creating the signed GitHub pull request is deliberately gated until the new registry repository and publisher identity flow are provisioned.</p>
        <button class="button" type="button" disabled>Submit signed release</button>
      </div>
    </aside>
  </section>

  <script>
    import { validatePackageManifest } from "../lib/checker.mjs";
    const form = document.querySelector("[data-publish-form]");
    const preview = document.querySelector("[data-manifest-preview]");
    const results = document.querySelector("[data-validation-results]");
    const state = document.querySelector("[data-package-state]");
    const files = document.querySelector("[data-package-files]");
    const inventory = document.querySelector("[data-file-inventory]");
    const download = document.querySelector("[data-download-manifest]");
    let currentManifest = {};

    const buildManifest = () => {
      if (!(form instanceof HTMLFormElement)) return {};
      const data = new FormData(form);
      return {
        name: String(data.get("name") || ""),
        version: String(data.get("version") || ""),
        kind: String(data.get("kind") || ""),
        entry: String(data.get("entry") || ""),
        accepts: String(data.get("accepts") || "").split(",").map((value) => value.trim()).filter(Boolean),
        description: String(data.get("description") || ""),
        license: String(data.get("license") || ""),
        capabilities: String(data.get("capabilities") || "").split(",").map((value) => value.trim()).filter(Boolean),
        profiles: ["core"],
        dependencies: {}
      };
    };

    const renderPreview = () => {
      currentManifest = buildManifest();
      if (preview) preview.textContent = JSON.stringify(currentManifest, null, 2);
    };

    form?.addEventListener("input", renderPreview);
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      renderPreview();
      const findings = validatePackageManifest(currentManifest);
      const errors = findings.filter(({ severity }) => severity === "error");
      if (state) {
        state.textContent = errors.length ? `${errors.length} blocking error${errors.length === 1 ? "" : "s"}` : "Ready to package";
        state.className = errors.length ? "state-error" : "state-ready";
      }
      if (results instanceof HTMLElement) {
        results.replaceChildren();
        if (!findings.length) {
          const success = document.createElement("p");
          success.className = "validation-success";
          success.textContent = "YES — the release manifest conforms to the registry package contract.";
          results.append(success);
        } else {
          findings.forEach((finding) => {
            const row = document.createElement("div");
            row.className = `validation-row validation-${finding.severity}`;
            const label = document.createElement("strong");
            label.textContent = finding.rule;
            const message = document.createElement("span");
            message.textContent = finding.message;
            row.append(label, message);
            results.append(row);
          });
        }
      }
    });

    files?.addEventListener("change", () => {
      if (!(files instanceof HTMLInputElement) || !(inventory instanceof HTMLElement)) return;
      const selected = [...(files.files || [])];
      inventory.textContent = selected.length ? selected.map((file) => `${file.name} · ${file.size.toLocaleString()} bytes`).join("\n") : "No package files selected.";
    });

    download?.addEventListener("click", () => {
      renderPreview();
      const blob = new Blob([`${JSON.stringify(currentManifest, null, 2)}\n`], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement("a");
      anchor.href = url;
      anchor.download = "hara.package.json";
      anchor.click();
      URL.revokeObjectURL(url);
    });

    renderPreview();
  </script>
</AppLayout>
