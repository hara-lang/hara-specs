---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Publish a specification — Hara Specs" description="Prepare and validate a versioned Hara project declaration for specification publication.">
  <section class="page-heading section-shell">
    <p class="hara-kicker">Project publishing</p>
    <h1>Prepare a specification release.</h1>
    <p>Specifications and packages use <code>project.edn</code> as their contributor-authored declaration. This surface validates the project coordinate, version, paths, capabilities, dependencies, and package options before a signed registry submission is prepared.</p>
  </section>

  <section class="publish-grid section-shell">
    <form class="publisher-form hara-surface" data-publish-form>
      <div class="form-row two-column">
        <label><span>Project coordinate</span><input name="coordinate" value="greenways/invoice-au" required /></label>
        <label><span>Version</span><input name="version" value="1.0.0" required /></label>
      </div>
      <div class="form-row two-column">
        <label><span>Main file</span><input name="main" value="spec/main.hal" required /></label>
        <label><span>Licence</span><input name="license" value="Apache-2.0" required /></label>
      </div>
      <div class="form-row three-column">
        <label><span>Source paths</span><input name="sourcePaths" value="spec" required /></label>
        <label><span>Test paths</span><input name="testPaths" value="test" required /></label>
        <label><span>Extension paths</span><input name="extensionPaths" value="extensions" required /></label>
      </div>
      <label><span>Capabilities</span><input name="capabilities" placeholder="document/read, fixture/read" /></label>
      <label><span>Description</span><textarea name="description" rows="3">Australian invoice conformance profile.</textarea></label>
      <label class="file-drop compact">
        <input type="file" multiple data-project-files />
        <span><strong>Add source, fixtures, and normative documents</strong><small>Files are inventoried locally; they are not uploaded by this prototype.</small></span>
      </label>
      <div class="file-inventory" data-file-inventory>No project files selected.</div>
      <div class="form-actions">
        <button class="button button-primary" type="submit">Validate project</button>
        <button class="button" type="button" data-download-project>Download project.edn</button>
      </div>
    </form>

    <aside class="publisher-preview hara-surface">
      <div class="preview-heading"><div><p class="hara-kicker">Project preview</p><h2>project.edn</h2></div><span data-project-state>Not validated</span></div>
      <pre><code data-project-preview></code></pre>
      <div class="validation-results" data-validation-results>
        Complete the project declaration and validate it against the Hara project contract.
      </div>
      <div class="publishing-gate">
        <strong>Registry submission transport</strong>
        <p>The canonical registry repository is active. Signed pull-request submission remains gated on publisher identity, namespace ownership, immutable-version enforcement, conformance fixtures, and path-scoped GitHub write credentials.</p>
        <button class="button" type="button" disabled>Submit signed release</button>
      </div>
    </aside>
  </section>

  <script>
    import { validateProjectManifest } from "../lib/checker.mjs";

    const form = document.querySelector("[data-publish-form]");
    const preview = document.querySelector("[data-project-preview]");
    const results = document.querySelector("[data-validation-results]");
    const state = document.querySelector("[data-project-state]");
    const files = document.querySelector("[data-project-files]");
    const inventory = document.querySelector("[data-file-inventory]");
    const download = document.querySelector("[data-download-project]");
    let currentProject = {};
    let currentSource = "";

    const commaValues = (value) => String(value || "")
      .split(",")
      .map((entry) => entry.trim())
      .filter(Boolean);

    const pathValues = (value) => commaValues(value);
    const keywordValues = (value) => commaValues(value)
      .map((entry) => `:${entry.replace(/^:/, "")}`);

    const buildProject = () => {
      if (!(form instanceof HTMLFormElement)) return {};
      const data = new FormData(form);
      return {
        "hara/type": ":project",
        "hara/version": "1.0.0",
        "project/id": String(data.get("coordinate") || ""),
        "project/version": String(data.get("version") || ""),
        "project/source-paths": pathValues(data.get("sourcePaths")),
        "project/test-paths": pathValues(data.get("testPaths")),
        "project/extension-paths": pathValues(data.get("extensionPaths")),
        "project/capabilities": keywordValues(data.get("capabilities")),
        "project/main": String(data.get("main") || ""),
        "project/dependencies": {},
        "project/package": {
          license: String(data.get("license") || ""),
          description: String(data.get("description") || "")
        }
      };
    };

    const quoted = (value) => JSON.stringify(String(value));
    const stringVector = (values) => `[${values.map(quoted).join(" ")}]`;
    const keywordSet = (values) => `#{${values.join(" ")}}`;

    const renderEdn = (project) => [
      "{:hara/type :project",
      ` :hara/version ${quoted(project["hara/version"])}`,
      ` :project/id ${project["project/id"] || "missing/project"}`,
      ` :project/version ${quoted(project["project/version"])}`,
      ` :project/source-paths ${stringVector(project["project/source-paths"] || [])}`,
      ` :project/test-paths ${stringVector(project["project/test-paths"] || [])}`,
      ` :project/extension-paths ${stringVector(project["project/extension-paths"] || [])}`,
      ` :project/capabilities ${keywordSet(project["project/capabilities"] || [])}`,
      ` :project/main ${quoted(project["project/main"])}`,
      " :project/dependencies {}",
      ` :project/package {:license ${quoted(project["project/package"]?.license || "")}`,
      `                   :description ${quoted(project["project/package"]?.description || "")}}}`
    ].join("\n");

    const renderPreview = () => {
      currentProject = buildProject();
      currentSource = `${renderEdn(currentProject)}\n`;
      if (preview) preview.textContent = currentSource;
    };

    form?.addEventListener("input", renderPreview);
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      renderPreview();
      const findings = validateProjectManifest(currentProject);
      const errors = findings.filter(({ severity }) => severity === "error");
      if (state) {
        state.textContent = errors.length ? `${errors.length} blocking error${errors.length === 1 ? "" : "s"}` : "Ready to submit";
        state.className = errors.length ? "state-error" : "state-ready";
      }
      if (results instanceof HTMLElement) {
        results.replaceChildren();
        if (!findings.length) {
          const success = document.createElement("p");
          success.className = "validation-success";
          success.textContent = "YES — project.edn conforms to the Hara project contract.";
          results.append(success);
        } else {
          findings.forEach((finding) => {
            const row = document.createElement("div");
            row.className = `validation-row validation-${finding.severity}`;
            const label = document.createElement("strong");
            label.textContent = finding.rule;
            const message = document.createElement("span");
            message.textContent = finding.message;
            row.append(label, message);
            results.append(row);
          });
        }
      }
    });

    files?.addEventListener("change", () => {
      if (!(files instanceof HTMLInputElement) || !(inventory instanceof HTMLElement)) return;
      const selected = [...(files.files || [])];
      inventory.textContent = selected.length
        ? selected.map((file) => `${file.name} · ${file.size.toLocaleString()} bytes`).join("\n")
        : "No project files selected.";
    });

    download?.addEventListener("click", () => {
      renderPreview();
      const blob = new Blob([currentSource], { type: "application/edn" });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement("a");
      anchor.href = url;
      anchor.download = "project.edn";
      anchor.click();
      URL.revokeObjectURL(url);
    });

    renderPreview();
  </script>
</AppLayout>
