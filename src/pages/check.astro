---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Check project.edn — Hara Specs" description="Inspect a Hara project manifest locally or through the conformity API.">
  <section class="page-heading section-shell">
    <p class="hara-kicker">Project conformance workbench</p>
    <h1>Inspect <code>project.edn</code> against the package contract.</h1>
    <p>The same EDN validator runs in the browser and through the service API. The document is parsed as data and never evaluated.</p>
  </section>

  <section class="workbench section-shell">
    <form class="checker-form hara-surface" data-check-form>
      <div class="form-row two-column">
        <label><span>Specification</span><select name="spec"><option value="hara/package@0.1.0">hara/package@0.1.0</option></select></label>
        <label><span>Profile</span><select name="profile"><option value="core">core</option><option value="strict">strict</option></select></label>
      </div>

      <fieldset class="execution-choice">
        <legend>Execution</legend>
        <label><input type="radio" name="execution" value="browser" checked /><span><strong>Browser</strong><small>Document remains on this device</small></span></label>
        <label><input type="radio" name="execution" value="server" /><span><strong>Server API</strong><small>Uses the Netlify function endpoint</small></span></label>
      </fieldset>

      <label class="file-drop">
        <input type="file" accept="application/edn,text/edn,.edn" data-document-file />
        <span><strong>Drop project.edn here</strong><small>or choose it from this device</small></span>
      </label>

      <label>
        <span>project.edn</span>
        <textarea name="document" rows="18" spellcheck="false" data-document-text>{`{:hara/type :project
 :hara/version "1.0.0"
 :project/id greenways/invoice-au
 :project/version "1.0.0"
 :project/source-paths ["src"]
 :project/test-paths ["test"]
 :project/extension-paths ["artifacts"]
 :project/capabilities #{}
 :project/dependencies {}
 :project/package {:license "Apache-2.0"}}`}</textarea>
      </label>

      <div class="form-actions">
        <button class="button button-primary" type="submit">Check project</button>
        <button class="button" type="button" data-load-invalid>Load failing example</button>
      </div>
    </form>

    <aside class="result-panel hara-surface" data-result aria-live="polite">
      <div class="result-idle"><span class="result-glyph" aria-hidden="true">◎</span><h2>Ready to inspect</h2><p>The verdict distinguishes non-conformity from parse and execution failures.</p></div>
    </aside>
  </section>

  <section class="api-contract section-shell">
    <div><p class="hara-kicker">Direct endpoint</p><h2>Validate the same file over HTTP.</h2><p>Send the EDN bytes to <code>POST /api/v1/packages/validate</code>.</p></div>
    <pre><code>{`curl https://specs.hara-lang.io/api/v1/packages/validate \
  -H 'content-type: application/edn' \
  --data-binary @project.edn`}</code></pre>
  </section>

  <script>
    import { runReferenceCheck } from "../lib/checker.mjs";
    const form = document.querySelector("[data-check-form]");
    const file = document.querySelector("[data-document-file]");
    const text = document.querySelector("[data-document-text]");
    const result = document.querySelector("[data-result]");
    const invalid = document.querySelector("[data-load-invalid]");
    const failingExample = `{:hara/type :project :project/id invoice :project/version "latest"}`;

    const render = (report) => {
      if (!(result instanceof HTMLElement)) return;
      result.replaceChildren();
      const wrapper = document.createElement("div");
      wrapper.className = `result-report result-${report.status === "completed" ? report.verdict : "error"}`;
      const eyebrow = document.createElement("p");
      eyebrow.className = "hara-kicker";
      eyebrow.textContent = report.status === "completed" ? "Conformity decision" : "Could not check";
      const heading = document.createElement("h2");
      heading.textContent = report.status === "completed" ? `${report.verdict.toUpperCase()} — ${report.conforms ? "CONFORMS" : "DOES NOT CONFORM"}` : "EXECUTION ERROR";
      const summary = document.createElement("p");
      summary.textContent = report.status === "completed" ? `${report.summary.errors} errors, ${report.summary.warnings} warnings, ${report.summary.rulesEvaluated} rules evaluated.` : report.error?.message || "The checker could not complete.";
      wrapper.append(eyebrow, heading, summary);
      if (Array.isArray(report.findings) && report.findings.length) {
        const list = document.createElement("ol");
        list.className = "finding-list";
        report.findings.forEach((finding) => {
          const item = document.createElement("li");
          item.dataset.severity = finding.severity;
          const title = document.createElement("strong"); title.textContent = finding.rule;
          const message = document.createElement("span"); message.textContent = finding.message;
          const where = document.createElement("code"); where.textContent = finding.path;
          item.append(title, message, where); list.append(item);
        });
        wrapper.append(list);
      }
      const engine = document.createElement("small");
      engine.className = "engine-note";
      engine.textContent = `${report.engine?.name || "checker"} · ${report.engine?.execution || "unknown"} · ${report.durationMs ?? 0} ms`;
      wrapper.append(engine); result.append(wrapper);
    };

    file?.addEventListener("change", async () => {
      if (!(file instanceof HTMLInputElement) || !(text instanceof HTMLTextAreaElement)) return;
      const selected = file.files?.[0]; if (selected) text.value = await selected.text();
    });
    invalid?.addEventListener("click", () => { if (text instanceof HTMLTextAreaElement) text.value = failingExample; });
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || !(text instanceof HTMLTextAreaElement)) return;
      const data = new FormData(form);
      const payload = { spec: String(data.get("spec")), profile: String(data.get("profile")), document: text.value, mediaType: "application/edn", execution: String(data.get("execution")) };
      if (result instanceof HTMLElement) result.innerHTML = '<div class="result-idle"><span class="result-glyph">◌</span><h2>Inspecting…</h2></div>';
      try {
        if (payload.execution === "server") {
          const response = await fetch("/api/v1/packages/validate", { method: "POST", headers: { "content-type": "application/edn" }, body: payload.document });
          const body = await response.json(); render(body.data || { status: "execution-error", conforms: null, error: body.error });
        } else render(runReferenceCheck(payload));
      } catch (error) {
        render({ status: "execution-error", conforms: null, error: { message: error instanceof Error ? error.message : "Unexpected client error." }, engine: { name: "browser-client", execution: "browser" }, durationMs: 0 });
      }
    });
  </script>
</AppLayout>
