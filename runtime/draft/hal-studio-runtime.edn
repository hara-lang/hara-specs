{:document/id :hal/studio-runtime
 :document/type :runtime-spec
 :document/version "1.1.0-draft"
 :document/status :draft
 :document/title "HAL programmable Studio and node runtime"
 :document/summary
 "Normative kernel, session, filesystem, editor, canvas, project, node, and wire contract."

 :runtime/builtins
 {:co {:qualified-prefix "co/"
       :availability :all-runtime-contexts}
  :node {:qualified-prefix "node/"
         :availability :node-bound-document-contexts
         :operations
         [{:symbol node/start :arguments [function] :returns :node/task-handle}
          {:symbol node/in :arguments [signal] :returns :promise/value}
          {:symbol node/in-frame :arguments [signal] :returns :promise/substrate-frame}
          {:symbol node/emit :arguments [signal value & [meta]] :returns :promise/acceptance}
          {:symbol node/call :arguments [target action args & [opts]] :returns :promise/response-value}
          {:symbol node/handle :arguments [action function & [meta]] :returns :node/handler-handle}
          {:symbol node/stop :arguments [task] :returns :boolean}
          {:symbol node/info :arguments [] :returns :node/public-info}]}}

 :runtime/kernel
 {:role :process-or-wasm-runtime-container
  :default-session "ROOT"
  :shared
  [:immutable-runtime-code :registered-standard-library-source]
  :session-registry
  {:operations
   [{:operation session/create :arguments [:session/id]}
    {:operation session/list :arguments []}
    {:operation session/info :arguments [:session/id]}
    {:operation session/attach-filesystem
     :arguments [:session/id :filesystem/provider-id]}
    {:operation session/eval :arguments [:session/id :source]}
    {:operation session/eval-bound :arguments [:session/id :source :bindings]}
    {:operation session/complete :arguments [:session/id :prefix]}
    {:operation session/close :arguments [:session/id]}]
   :legacy-aliases
   {:eval [:session/eval "ROOT"]
    :eval-bound [:session/eval-bound "ROOT"]
    :complete [:session/complete "ROOT"]}}}

 :runtime/session
 {:owns
  [:environment :namespace-registry :module-load-state :protocols
   :fibers :task-handles :document-generations :current-namespace
   :project-cache :capabilities :filesystem-attachment]
  :host-call-identity [:kernel/id :session/id :task/id]
  :close
  [:cancel-tasks :reject-pending-host-calls :release-document-generations
   :release-capabilities :detach-filesystem]
  :isolation
  "Closing or resetting one session MUST NOT mutate any other session in the same kernel."}

 :runtime/filesystem-provider
 {:identity :opaque-host-provider-id
  :operations [:resolve :read :write :exists :list :mkdir :delete]
  :browser
  {:ephemeral :session-lifetime-memory
   :persistent :explicit-keyed-indexeddb}
  :native :host-confined-provider
  :reattach
  {:precondition
   :no-active-evaluations-tasks-document-generations-or-pending-host-calls
   :busy-error "SESSION_BUSY"
   :validation :before-reset
   :failure :atomic
   :success
   [:preserve-session-id :reset-language-state :reset-project-cache
    :detach-previous-provider :attach-new-provider]}
  :compatibility
  {:studio.fs :facade-over-attached-provider
   :std.foundation.file :attached-provider}}

 :runtime/documentation-embedding
 {:default
  {:kernel :one-lazy-page-kernel
   :session :one-private-session-per-live-embed
   :filesystem :ephemeral-memory}
  :attributes
  {"data-hara-filesystem" :explicit-shared-indexeddb-key
   "data-hara-kernel=isolated" :dedicated-worker-and-wasm-kernel}
  :canvas-routing :originating-session
  :ui-identity [:kernel-scope :session/id :filesystem-kind]}

 :runtime/studio-editor
 {:authorities
  {:persisted-source
   "The attached filesystem provider owns the last explicitly saved bytes."
   :editor-buffer
   "The editor owns the current unsaved bytes and dirty state."
   :active-generation
   "The document registry owns the last successfully activated ns+ generation."}
  :document-id [:project/id :filesystem-space :normalized-path]
  :operations
  {:open
   {:reads :persisted-source
    :unsaved-buffer-policy :require-explicit-discard-before-replacement}
   :save
   {:source :editor-buffer
    :target :attached-filesystem-provider
    :effect [:replace-persisted-source :clear-dirty-state]
    :evaluation false}
   :run-file
   {:source :editor-buffer
    :filesystem-write false
    :dirty-state :unchanged
    :ordinary-module :evaluate-in-selected-session
    :anonymous-module
    [:prepare-candidate-generation :start-candidate-node-tasks
     :await-required-activation-gates :commit-candidate-generation]}
   :run-form
   {:source :explicit-selection-or-innermost-complete-form
    :target :active-document-generation-when-present
    :fallback :selected-session}
   :complete
   {:target :active-document-generation-when-present
    :fallback :selected-session}}
  :keyboard
  {"Ctrl-or-Meta-S" :save
   "Ctrl-or-Meta-E" :run-form
   "Ctrl-or-Meta-Enter" :run-file}
  :invariants
  [{:id :editor/run-does-not-save
    :text "Running a file or form MUST NOT modify persisted source or clear dirty state."}
   {:id :editor/path-scoped-generation
    :text "Document generations MUST include project, filesystem space, and normalized path in their identity."}
   {:id :editor/failed-candidate-retains-active
    :text "A failed candidate MUST be discarded without replacing the active generation."}]}

 :runtime/studio-canvas
 {:identity
  {:surface :host-canvas-element
   :semantic-canvas-id :session-local-name
   :owner :active-document-generation
   :candidate :prepared-document-generation}
  :ownership
  {:per-physical-surface
   {:committed-owner :at-most-one
    :candidate-owner :at-most-one}
   :operations
   [:register :claim :stage :wait-for-first-render :commit :discard :release]
   :replacement
   [:cancel-pending-frame :reject-former-owner-render :release-resources]}
  :activation
  {:canvas-document-gate :candidate-first-successful-render
   :success [:commit-document-generation :commit-canvas-owner]
   :failure [:discard-document-generation :discard-canvas-candidate]
   :pixel-atomicity
   "The first candidate frame is the activation proof; hosts need not double-buffer the previous pixels."}
  :frame
  {:scheduler :host-animation-frame
   :geometry :integer-css-pixels
   :backing-store :css-size-times-device-pixel-ratio
   :maximum-device-pixel-ratio 2
   :input-delivery :exactly-once-on-next-frame}
  :input
  {:scope :session-canvas-runtime
   :visible-only true
   :queue-limit 128
   :events [:keyboard :pointer]}
  :close
  [:remove-host-listeners :reject-pending-frames :release-webgl-resources
   :clear-surface-ownership :clear-input-queue]}

 :runtime/studio-embedding
 {:layout
  [:filesystem-tree :editor :repl-log :status-strip :optional-canvas]
  :selected-target
  [:kernel/id :session/id :filesystem/provider-id]
  :private-document-sessions true
  :host-routing
  "Editor evaluation, filesystem calls, canvas calls, and input MUST route using the originating kernel and session identity."
  :documentation-difference
  "Generated Markdown may choose a compact per-embed layout, but it obeys the same session, filesystem, document-generation, and canvas contracts."}

 :runtime/anonymous-module
 {:form ns+
  :position :first-effective-top-level-form
  :grammar "(ns+ clause*)"
  :clauses :same-as-ns-except-name
  :identity [:kernel/id :document/id :generation]
  :public-registry false
  :qualified-access false
  :require-target false
  :project-main false
  :lifecycle
  {:whole-file-run
   [:allocate-candidate-generation
    :evaluate-source
    :prepare-node-scope
    :atomically-activate-on-success
    :cancel-and-release-previous-generation]
   :failed-run
   [:cancel-candidate-tasks
    :release-candidate-module
    :retain-previous-active-generation]
   :form-run :reuse-active-generation
   :document-close
   [:cancel-pending-node-tasks
    :unsubscribe-inputs
    :reject-pending-calls
    :remove-handlers
    :release-private-module]}}

 :runtime/node-module-ownership
 {:public-identity :workspace/node-id
  :binding
  {:workspace-node :one-active-document-generation
   :document-generation :one-private-ns+-module
   :private-module :one-node-execution-scope}
  :scope-owns
  [:public-node-id
   :workspace-space-id
   :declared-ports
   :capabilities
   :task-supervisor
   :input-subscriptions
   :request-handlers
   :pending-calls
   :transport-context]
  :invariants
  [{:id :node/public-frame-identity
    :text "Frames expose the workspace node ID, never the private module ID."}
   {:id :node/atomic-generation
    :text "Handlers, subscriptions, tasks, and module bindings activate as one generation."}
   {:id :node/no-shared-anonymous-module
    :text "Two node instances never share an ns+ module even when they use identical source."}
   {:id :node/explicit-concurrency
    :text "A node processes sequentially unless source starts additional node tasks."}]}

 :runtime/document-protocol
 [{:operation prepareDocument
   :arguments [:kernel/id :document/id :source :node/id]
   :effect :uncommitted-candidate-generation
   :returns [:value :generation :module/id]}
  {:operation commitDocument
   :arguments [:candidate-generation]
   :effect :atomically-replace-active-generation}
  {:operation discardDocument
   :arguments [:candidate-generation]
   :effect :release-candidate-without-replacing-active}
  {:operation evalDocument
   :arguments [:kernel/id :document/id :source :node/id]
   :effect :prepare-and-immediately-commit
   :compatibility true
   :returns [:value :generation :module/id]}
  {:operation evalForm
   :arguments [:kernel/id :document/id :source]
   :effect :active-generation
   :returns :value}
  {:operation releaseDocument
   :arguments [:kernel/id :document/id]
   :effect :release-generation
   :returns :released-count}]

 :runtime/project
 {:file "project.edn"
  :required true
  :loads-before "workspace.edn"
  :required-keys
  [:hara/type :hara/version :project/id :project/version
   :project/source-paths :project/test-paths :project/extension-paths
   :project/capabilities]
  :optional-keys [:project/main]
  :legacy-read-only ["project.hal" "project.hara"]}

 :runtime/workspace
 {:file "workspace.edn"
  :required true
  :directly-loadable true
  :root :containing-directory
  :required-keys
  [:hara/type :hara/version :workspace/id :workspace/layout
   :workspace/documents :workspace/areas :workspace/nodes
   :workspace/connections :workspace/links :workspace/customizations]
  :persistent
  [:layout :areas :documents :nodes :ports :connections :links
   :playlist-metadata :permitted-file-handle-keys]
  :ephemeral
  [:pixels :audio-buffers :kernel-values :anonymous-module-handles
   :absolute-machine-paths]
  :mutation
  {:undo-redo true
   :dirty-state true
   :explicit-save true
   :recovery-journal :automatic-local
   :external-change-detection :content-hash
   :conflict-policy :never-overwrite-silently
   :serialization :canonical-edn}}

 :runtime/wire
 {:logical-model :xt.substrate
  :implementation :hara-native
  :compatibility :existing-json-frames-remain-valid
  :version "substrate.v1"
  :json
  {:required true
   :role :portable-control-and-ordinary-data
   :binary-descriptor
   {:$hara/type "hara.bytes.v1"
    :encoding "base64"
    :optional-array-type true}}
  :frame-fields
  [:version :kind :id :source :target :space :signal :action :args
   :reply_to :status :data :error :cause :meta]
  :workflows
  {:request-response [:node/call :node/handle]
   :streams [:node/emit :node/in :node/in-frame]
   :subscriptions :workspace-connections
   :fan-out :router
   :correlation [:id :reply_to :cause]
   :pending-promises :runtime-owned}
  :transport-negotiation
  {:metadata-handler "@/node-info"
   :transports
   [{:id :direct :frame :logical}
    {:id :hta1 :frame :binary}
    {:id :structured-clone :frame :logical}
    {:id :transferable :frame :logical :payload :array-buffer}
    {:id :websocket :frame :json-text}
    {:id :shared-audio-ring :payload :shared-array-buffer
     :constraint :cross-origin-isolated}
    {:id :audio-block-batch :payload :transferable-array-buffer
     :fallback-for :shared-audio-ring}]}
  :realtime-audio
  {:uses-json false
   :waits-for-visualizer false
   :visualizer-delivery :latest
   :emit-acknowledgement :downstream-queue-accepted}}

 :runtime/security
 {:capability-source "project.edn"
  :local-media
  {:requires-user-gesture true
   :audio-data-persisted false
   :machine-path-persisted false
   :file-handle-permission :local-browser-store}}}
