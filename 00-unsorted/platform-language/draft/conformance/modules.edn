{:spec/version "0.1"
 :language "hal-modules"
 :description
 "Cross-runtime acceptance scenarios for namespace identity, transactional modules, lazy loading, macros, sessions, and retained REPL state."
 :runtime/profiles
 {:jvm-truffle
  {:resource-order
   [:loaded-native-namespace
    :runtime-library
    :project-source
    :classpath-source
    :extension-package]}
  :rust
  {:resource-order
   [:loaded-native-namespace
    :registered-resource
    :registered-extension]}}
 :cases
 [{:id :namespace/alias-var-identity
   :area :namespace
   :scenario :var-identity
   :expect {:same-var true :live-root true}}
  {:id :namespace/refer-var-identity
   :area :namespace
   :scenario :var-identity
   :expect {:same-var true :live-root true}}
  {:id :namespace/use-declaration
   :area :namespace
   :scenario :use
   :expect {:vars-visible true
            :macros-visible true
            :preserves-var-identity true}}
  {:id :namespace/facade-var-copy
   :area :namespace
   :scenario :facade
   :expect {:same-var false :copied-root true :copied-metadata true}}
  {:id :namespace/with-ns-success
   :area :namespace
   :scenario :with-ns
   :expect {:result :target-final-value :caller-restored true}}
  {:id :namespace/with-ns-failure
   :area :namespace
   :scenario :with-ns
   :expect {:error :guest :caller-restored true}}
  {:id :namespace/with-ns-lexical-isolation
   :area :namespace
   :scenario :with-ns
   :expect {:caller-locals-visible false}}
  {:id :namespace/loading-state
   :area :namespace
   :scenario :state-inspection
   :expect {:non-forcing true
            :states [:unknown :unloaded :loading :loaded :failed]}}
  {:id :namespace/cross-namespace-alias-state
   :area :namespace
   :scenario :state-inspection
   :expect {:owner-explicit true :non-forcing true}}

  {:id :module/canonical-cache
   :area :module
   :scenario :canonical-identity
   :expect {:initial-revision 1 :duplicate-evaluation false}}
  {:id :module/dependency-order
   :area :module
   :scenario :dependency-graph
   :expect {:order :dependency-first-source-order}}
  {:id :module/cycle-rollback
   :area :module
   :scenario :transaction
   :expect {:error :cycle :partial-state false}}
  {:id :module/failure-rollback
   :area :module
   :scenario :transaction
   :expect {:partial-vars false
            :partial-macros false
            :partial-dependencies false
            :revision-increment false}}
  {:id :module/reload-revision
   :area :module
   :scenario :reload
   :expect {:revision-increment 1 :new-compilation-sees-root true}}
  {:id :module/reload-rollback
   :area :module
   :scenario :reload
   :expect {:previous-revision-preserved true :previous-roots-preserved true}}
  {:id :module/resource-precedence
   :area :module
   :scenario :resolution
   :expect {:deterministic true
            :declared-by-runtime-profile true
            :same-canonical-resource-evaluated-once true}}
  {:id :module/source-hir-parity
   :area :module
   :scenario :hir
   :expect {:same-value true :same-var-metadata true :same-error-category true}}

  {:id :lazy/non-forcing
   :area :lazy
   :scenario :lazy-alias
   :expect {:state :unloaded :target-evaluated false}}
  {:id :lazy/qualified-force
   :area :lazy
   :scenario :lazy-alias
   :expect {:state :loaded :target-evaluations 1}}
  {:id :lazy/failure-state
   :area :lazy
   :scenario :lazy-alias
   :expect {:state :failed :partial-state false}}
  {:id :lazy/explicit-retry
   :area :lazy
   :scenario :lazy-alias
   :expect {:ordinary-force-retries false :reload-retries true}}
  {:id :macro/reload-new-compilation
   :area :macro
   :scenario :reload
   :expect {:existing-call-target :unchanged :new-compilation :new-expansion}}

  {:id :session/namespace-isolation
   :area :session
   :scenario :isolation
   :expect {:vars-shared false :modules-shared false :macros-shared false}}
  {:id :session/dynamic-unwind
   :area :session
   :scenario :dynamic-binding
   :expect {:binding-session-local true :restored-after-error true}}
  {:id :session/immutable-transfer
   :area :session
   :scenario :transfer
   :expect {:immutable-data true}}
  {:id :session/reject-live-transfer
   :area :session
   :scenario :transfer
   :expect {:functions false
            :vars false
            :mutable-references false
            :streams false
            :sockets false
            :host-handles false}}
  {:id :repl/retained-state
   :area :repl
   :scenario :retained-session
   :expect {:namespace-retained true :history-retained true :multiline true}}
  {:id :repl/error-recovery
   :area :repl
   :scenario :retained-session
   :expect {:session-survives true :namespace-restored true}}]}
