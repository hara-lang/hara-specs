{:conformance/id :hara.cli/routes
 :conformance/version "0.1.0"
 :conformance/cases
 [{:case/id :hara.cli.route/project-check-canonical
   :case/argv ["project" "check" "demo"]
   :case/expected {:route/id :hara.cli.route/project-check
                   :route/arguments ["demo"]}}
  {:case/id :hara.cli.route/project-check-alias
   :case/argv ["check" "demo"]
   :case/expected {:route/id :hara.cli.route/project-check
                   :route/arguments ["demo"]}}
  {:case/id :hara.cli.route/run-file
   :case/argv ["run" "demo.hal"]
   :case/expected {:route/id :hara.cli.route/run-file
                   :route/arguments ["demo.hal"]}}
  {:case/id :hara.cli.route/project-run
   :case/argv ["project" "run"]
   :case/expected {:route/id :hara.cli.route/project-run
                   :route/arguments []}}
  {:case/id :hara.cli.route/legacy-project-run
   :case/argv ["run"]
   :case/expected {:route/id :hara.cli.route/project-run
                   :route/arguments []}}
  {:case/id :hara.cli.route/headless-alias
   :case/argv ["headless"]
   :case/expected {:route/id :hara.cli.route/server
                   :route/arguments []}}
  {:case/id :hara.cli.route/package-registry-longest-prefix
   :case/argv ["package" "registry" "list"]
   :case/expected {:route/id :hara.cli.route/package-registry
                   :route/arguments ["list"]}}
  {:case/id :hara.cli.route/spec-contribution-longest-prefix
   :case/argv ["spec" "check-contribution" "candidate"]
   :case/expected {:route/id :hara.cli.route/spec-check-contribution
                   :route/arguments ["candidate"]}}
  {:case/id :hara.cli.route/unknown
   :case/argv ["publish-directly"]
   :case/expected {:outcome/id :hara.cli.outcome/usage-error}}]}
