{:document/id :hara/chip-base
 :document/type :chip-base-spec
 :document/version "0.1.0-draft"
 :document/status :draft
 :document/title "Hara chip-base AST matcher"
 :document/summary
 "Portable contract for a bounded coprocessor that matches compiled structural patterns against immutable compact AST arenas."

 :spec/conforms-to
 {:spec/id :hara/chip-base-metaspec
  :spec/version "0.1.0"}

 :chip/scope
 {:scope/owner :cpu
  :scope/coprocessor :ast-matcher
  :scope/includes
  #{:compact-ast-arena :compiled-pattern-programs :structural-matching
    :wildcard-bindings :bounded-faults :performance-counters}
  :scope/excludes
  #{:evaluation :control-flow :garbage-collection :macro-semantics
    :symbolic-arithmetic :mutable-ast :automatic-rewriting
    :node-construction :copy-path :custom-instruction-encoding
    :cache-coherence :multiple-match-contexts}
  :scope/software-responsibilities
  #{:hara-object-encoding :pattern-compilation :symbol-interning
    :job-submission :result-decoding :rewrite-application
    :arena-lifetime :semantic-equivalence-checking}
  :scope/hardware-responsibilities
  #{:program-execution :bounded-node-access :tag-testing
    :literal-testing :child-loading :binding :result-reporting}}

 :chip/invariants
 [{:requirement/id :chip-base/cpu-ownership
   :requirement/level :must
   :requirement/text
   "The CPU owns program semantics, control flow, memory lifetime, pattern compilation, and rewriting; the coprocessor only executes submitted matching jobs."}
  {:requirement/id :chip-base/immutable-input
   :requirement/level :must
   :requirement/text
   "A submitted AST arena and its referenced child tails remain immutable until the corresponding result is consumed."}
  {:requirement/id :chip-base/node-reference
   :requirement/level :must
   :requirement/text
   "Every architectural node reference is a 32-bit byte offset from the job's AST arena base and is aligned to 16 bytes."}
  {:requirement/id :chip-base/no-out-of-bounds-read
   :requirement/level :must
   :requirement/text
   "The coprocessor validates every program, constant, node, and child-tail access against the submitted bounds before issuing the access."}
  {:requirement/id :chip-base/deterministic
   :requirement/level :must
   :requirement/text
   "For identical program bytes, constant bytes, arena bytes, and root reference, execution produces the same terminal result and bindings."}
  {:requirement/id :chip-base/no-partial-bindings
   :requirement/level :must
   :requirement/text
   "A no-match or fault result exposes no valid binding entries."}
  {:requirement/id :chip-base/binding-reference-equality
   :requirement/level :must
   :requirement/text
   "Repeated binding tests compare node references, not recursively computed structural values; software canonicalizes equivalent subtrees or retains the match in software when structural equality is required."}
  {:requirement/id :chip-base/symbol-id-coherence
   :requirement/level :must
   :requirement/text
   "Pattern constants and AST nodes in a job use the same software-defined symbol-ID domain."}
  {:requirement/id :chip-base/narrow-integer-profile
   :requirement/level :must
   :requirement/text
   "The baseline integer tag represents only signed 32-bit values; software does not offload literal tests for integers outside that range."}
  {:requirement/id :chip-base/forward-progress
   :requirement/level :must
   :requirement/text
   "Every accepted job reaches match, no-match, or fault within the configured instruction budget, excluding finite external-memory stalls."}]

 :chip/parameters
 {:parameter/node-width-bits 128
  :parameter/node-alignment-bytes 16
  :parameter/node-reference-bits 32
  :parameter/null-node-reference 4294967295
  :parameter/instruction-width-bits 64
  :parameter/constant-width-bits 64
  :parameter/node-register-count 16
  :parameter/binding-register-count 8
  :parameter/max-children 65535
  :parameter/max-program-instructions 65535
  :parameter/default-instruction-budget 65536
  :parameter/program-counter-bits 16}

 :chip/node-format
 {:node/byte-order :little-endian
  :node/address-rule
  {:address/expression "arena_base + node_reference"
   :address/alignment-bytes 16
   :address/validity
   "node_reference is not the null reference and node_reference + 16 does not exceed arena_size"}
  :node/fields
  [{:field/name :node/tag
    :field/bits [127 120]
    :field/width 8}
   {:field/name :node/flags
    :field/bits [119 112]
    :field/width 8}
   {:field/name :node/aux
    :field/bits [111 96]
    :field/width 16}
   {:field/name :node/child-0
    :field/bits [95 64]
    :field/width 32}
   {:field/name :node/child-1
    :field/bits [63 32]
    :field/width 32}
   {:field/name :node/payload
    :field/bits [31 0]
    :field/width 32}]
  :node/tags
  [{:tag/name :integer :tag/code 1 :tag/kind :literal}
   {:tag/name :symbol :tag/code 2 :tag/kind :literal}
   {:tag/name :list :tag/code 3 :tag/kind :collection}
   {:tag/name :vector :tag/code 4 :tag/kind :collection}
   {:tag/name :call :tag/code 16 :tag/kind :collection}
   {:tag/name :if :tag/code 17 :tag/kind :collection}
   {:tag/name :fn :tag/code 18 :tag/kind :collection}
   {:tag/name :wildcard :tag/code 32 :tag/kind :pattern-source}]
  :node/flags
  [{:flag/name :immutable :flag/bit 0
    :flag/required true}
   {:flag/name :literal :flag/bit 1
    :flag/required-for #{:integer :symbol}}
   {:flag/name :has-hash :flag/bit 2
    :flag/reserved-for-future true
    :flag/required-value 0}
   {:flag/name :variadic :flag/bit 3
    :flag/reserved-for-future true
    :flag/required-value 0}
   {:flag/name :inline-payload :flag/bit 4
    :flag/reserved-for-future true
    :flag/required-value 0}]
  :node/tag-semantics
  [{:tag/name :integer
    :tag/aux 0
    :tag/children :none
    :tag/payload :signed-32-bit-twos-complement}
   {:tag/name :symbol
    :tag/aux 0
    :tag/children :none
    :tag/payload :software-interned-symbol-id}
   {:tag/name :wildcard
    :tag/aux 0
    :tag/children :none
    :tag/payload :software-pattern-variable-id}
   {:tag/name :list
    :tag/aux :arity
    :tag/children :indexed}
   {:tag/name :vector
    :tag/aux :arity
    :tag/children :indexed}
   {:tag/name :call
    :tag/aux :arity
    :tag/children :indexed}
   {:tag/name :if
    :tag/aux :arity
    :tag/children :indexed}
   {:tag/name :fn
    :tag/aux :arity
    :tag/children :indexed}]
  :node/child-storage
  {:children/arity-field :node/aux
   :children/index-zero :node/child-0
   :children/index-one :node/child-1
   :children/null-unused true
   :children/tail-start-index 2
   :children/tail-offset-field :node/payload
   :children/tail-element-width-bits 32
   :children/tail-address-expression
   "arena_base + payload + 4 * (child_index - 2)"
   :children/tail-alignment-bytes 4
   :children/rule
   "For arity greater than two, payload is a byte offset to arity minus two packed node references in the same arena."}
  :node/literal-constant-format
  {:constant/width-bits 64
   :constant/fields
   [{:field/name :constant/tag :field/bits [63 56] :field/width 8}
    {:field/name :constant/reserved :field/bits [55 48] :field/width 8}
    {:field/name :constant/aux :field/bits [47 32] :field/width 16}
    {:field/name :constant/payload :field/bits [31 0] :field/width 32}]
   :constant/equality
   "TEST_LITERAL succeeds exactly when node tag, aux, and payload equal the selected constant; node flags and child fields are ignored."}}

 :chip/program-format
 {:program/byte-order :little-endian
  :program/instruction-fields
  [{:field/name :instruction/opcode
    :field/bits [63 56]
    :field/width 8}
   {:field/name :instruction/destination
    :field/bits [55 52]
    :field/width 4}
   {:field/name :instruction/source
    :field/bits [51 48]
    :field/width 4}
   {:field/name :instruction/binding
    :field/bits [47 45]
    :field/width 3}
   {:field/name :instruction/reserved
    :field/bits [44 32]
    :field/width 13}
   {:field/name :instruction/immediate
    :field/bits [31 0]
    :field/width 32}]
  :program/initial-state
  {:state/program-counter 0
   :state/node-register-0 :command/root-node
   :state/node-registers-1-through-15 :invalid
   :state/binding-registers :invalid
   :state/executed-instructions 0}
  :program/opcodes
  [{:opcode/name :load-child
    :opcode/code 1
    :opcode/operands
    [:instruction/destination :instruction/source :instruction/immediate]
    :opcode/semantics
    "Load child index immediate[15:0] from the source node into the destination node register; fault if the source is invalid, non-collection, or the index is outside its arity."}
   {:opcode/name :test-tag
    :opcode/code 2
    :opcode/operands [:instruction/source :instruction/immediate]
    :opcode/semantics
    "Continue when the source node tag equals immediate[7:0]; otherwise terminate with no-match."}
   {:opcode/name :test-literal
    :opcode/code 3
    :opcode/operands [:instruction/source :instruction/immediate]
    :opcode/semantics
    "Continue when the source node equals the literal constant indexed by immediate; otherwise terminate with no-match."}
   {:opcode/name :bind
    :opcode/code 4
    :opcode/operands [:instruction/source :instruction/binding]
    :opcode/semantics
    "If the selected binding is invalid, copy the source node reference into it; if already valid, continue only when it equals the source node reference, otherwise terminate with no-match."}
   {:opcode/name :test-bound
    :opcode/code 5
    :opcode/operands [:instruction/source :instruction/binding]
    :opcode/semantics
    "Continue when the selected binding is valid and equals the source node reference; otherwise terminate with no-match."}
   {:opcode/name :jump
    :opcode/code 6
    :opcode/operands [:instruction/immediate]
    :opcode/semantics
    "Add the signed 32-bit immediate to the already incremented program counter; fault if the target is outside the program."}
   {:opcode/name :accept
    :opcode/code 7
    :opcode/operands []
    :opcode/semantics
    "Terminate with match and return the valid prefix declared by the pattern descriptor's binding count."}
   {:opcode/name :fail
    :opcode/code 8
    :opcode/operands []
    :opcode/semantics
    "Terminate with no-match."}]
  :program/execution
  {:execution/fetch
   "Fetch the instruction at program_base + 8 * program_counter after checking program_counter against program_count."
   :execution/increment
   "Increment program_counter after fetch and before applying opcode semantics."
   :execution/reserved-bits
   "All reserved instruction bits must be zero."
   :execution/unused-operands
   "Operand fields not named by an opcode must be zero."
   :execution/instruction-budget
   "A command budget of zero selects default-instruction-budget. Fault before executing an instruction that would make executed_instructions exceed the effective command budget."
   :execution/accept-bindings
   "ACCEPT faults with invalid-binding if any binding register below pattern binding-count is invalid."
   :execution/terminal
   #{:match :no-match :fault}}}

 :chip/commands
 [{:command/name :match
   :command/code 1
   :command/fields
   [{:field/name :command/job-id :field/type :unsigned-32}
    {:field/name :command/pattern-id :field/type :unsigned-32}
    {:field/name :command/root-node :field/type :node-reference}
    {:field/name :command/arena-base :field/type :physical-address}
    {:field/name :command/arena-size :field/type :unsigned-32}
    {:field/name :command/instruction-budget :field/type :unsigned-32}]
   :command/descriptor
   "pattern-id indexes a software-owned, immutable pattern table configured before job submission."}]

 :chip/pattern-descriptor
 {:pattern/fields
  [{:field/name :pattern/program-base :field/type :physical-address}
   {:field/name :pattern/program-count :field/type :unsigned-16}
   {:field/name :pattern/constant-base :field/type :physical-address}
   {:field/name :pattern/constant-count :field/type :unsigned-16}
   {:field/name :pattern/binding-count :field/type :unsigned-4}]
  :pattern/constraints
  ["program-count is at least one and no greater than max-program-instructions"
   "binding-count is no greater than binding-register-count"
   "program and constant storage remains immutable until all referencing jobs complete"]}

 :chip/results
 {:result/fields
  [{:field/name :result/job-id :field/type :unsigned-32}
   {:field/name :result/status
    :field/type :enum
    :field/values [:match :no-match :fault]}
   {:field/name :result/binding-count :field/type :unsigned-4}
   {:field/name :result/bindings
    :field/type :node-reference-vector
    :field/count 8}
   {:field/name :result/error :field/type :error-code}
   {:field/name :result/program-counter :field/type :unsigned-16}
   {:field/name :result/executed-instructions :field/type :unsigned-32}]
  :result/match
  "A match result returns exactly pattern binding-count valid bindings in ascending register order and error none."
  :result/no-match
  "A no-match result returns binding-count zero, all binding entries null, and error none."
  :result/fault
  "A fault result returns binding-count zero, all binding entries null, and the first architecturally detected error."
  :result/order
  "A single-context implementation emits results in accepted-command order."}

 :chip/errors
 [{:error/name :none :error/code 0}
  {:error/name :invalid-command :error/code 1}
  {:error/name :invalid-pattern :error/code 2}
  {:error/name :invalid-program-counter :error/code 3}
  {:error/name :invalid-opcode :error/code 4}
  {:error/name :nonzero-reserved-bits :error/code 5}
  {:error/name :invalid-register :error/code 6}
  {:error/name :invalid-binding :error/code 7}
  {:error/name :invalid-constant :error/code 8}
  {:error/name :invalid-node-reference :error/code 9}
  {:error/name :invalid-child-index :error/code 10}
  {:error/name :invalid-child-tail :error/code 11}
  {:error/name :instruction-budget-exhausted :error/code 12}
  {:error/name :memory-access-fault :error/code 13}]

 :chip/architecture
 {:architecture/required-blocks
  #{:command-fifo :result-fifo :matcher-controller :node-register-file
    :binding-register-file :bounded-memory-reader :performance-counters}
  :architecture/recommended-blocks
  #{:node-cache :child-prefetch}
  :architecture/minimum-profile
  {:profile/match-contexts 1
   :profile/node-cache-bytes {:range/min 4096 :range/max 16384}
   :profile/node-cache-ports {:range/min 1 :range/max 2}
   :profile/program-issue-width 1}
  :architecture/performance-counters
  #{:accepted-jobs :matched-jobs :no-match-jobs :faulted-jobs
    :executed-instructions :node-header-reads :child-tail-reads
    :node-cache-hits :node-cache-misses :external-memory-stall-cycles}}

 :chip/transport
 {:transport/normative-boundary
  "Command, pattern, result, and memory semantics are normative; their bus-level encoding is integration-specific."
  :transport/first-profile
  {:profile/control :mmio
   :profile/data :shared-memory
   :profile/completion #{:polling :interrupt}}
  :transport/future-profiles
  #{:risc-v-custom-instruction :rocc :cv-x-if :axi :tilelink}}

 :chip/deferred
 [{:feature/name :node-construction
   :feature/after :validated-matcher-benefit
   :feature/model :immutable-bump-allocated-arena}
  {:feature/name :copy-path
   :feature/after :node-construction
   :feature/model :persistent-path-copying}
  {:feature/name :multiple-contexts
   :feature/after :memory-stall-measurement}
  {:feature/name :custom-instructions
   :feature/after :mmio-break-even-measurement}]

