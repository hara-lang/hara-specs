{:document/id :hara.substrate.conformance/stream-router
 :document/type :substrate-conformance
 :document/version "0.1.0"
 :document/status :draft
 :conformance/spec :hara/substrate-stream-router
 :conformance/cases
 [{:case/id :hara.substrate.stream/local-before-route
   :case/given [:trigger/registered :subscription/two-transports]
   :case/when :stream/publish
   :case/then [:trigger/invoked-once :router/after-trigger]}
  {:case/id :hara.substrate.stream/stable-fanout
   :case/given [:transport/id-z :transport/id-a]
   :case/when :stream/publish
   :case/then [:transport/id-a-sent-first :transport/id-z-sent-second]}
  {:case/id :hara.substrate.stream/latest-overflow
   :case/given [:delivery/latest :stream/backpressure]
   :case/when [:stream/publish-a :stream/publish-b]
   :case/then [:stream/a-replaced :stream/b-delivered]}
  {:case/id :hara.substrate.stream/cause
   :case/given [:frame/originating-id]
   :case/when :stream/derive
   :case/then [:frame/cause-id-preserved]}
  {:case/id :hara.substrate.stream/unsubscribe-idempotent
   :case/given [:subscription/registered]
   :case/when [:subscription/remove :subscription/remove]
   :case/then [:subscription/absent :operation/no-error]}
  {:case/id :hara.substrate.stream/owner-stop
   :case/given [:service/owns-trigger :transport/owns-subscription]
   :case/when [:service/stop :transport/stop]
   :case/then [:trigger/absent :subscription/absent]}]}
